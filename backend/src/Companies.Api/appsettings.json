{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Relevance": {
    "Threshold": 0.6,
    "ContentInspection": {
      "Enabled": true
    }
  },
  "WebsiteFetcher": {
    "Timeout": "00:00:03",
    "MaxResponseBytes": 262144,
    "MaxRedirects": 3
  }
}
